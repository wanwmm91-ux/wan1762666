                local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myPos = myHRP and myHRP.Position or _C.CFrame.Position
                local processed = {}
                local count = 0

                for _, m in ipairs(folder:GetChildren()) do
                    if count >= _MX then break end
                    if m:IsA("Model") and m.Name ~= _LP.Name and _iE(m) then
                        local topPos, botPos = _gBB(m)
                        if topPos and botPos then
                            processed[m] = true
                            count = count + 1
                            local topSp, topOn = _C:WorldToViewportPoint(topPos)
                            local botSp, botOn = _C:WorldToViewportPoint(botPos)
                            if topOn and botOn then
                                local h = botSp.Y - topSp.Y
                                if h > 4 then
                                    if not _EB[m] then
                                        local box = Instance.new("Frame")
                                        box.BackgroundTransparency = 1
                                        box.BorderSizePixel = 0
                                        box.ZIndex = 45
                                        box.Parent = _EC2
                                        local stroke = Instance.new("UIStroke", box)
