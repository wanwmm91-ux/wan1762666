-- ============ 工具 ============
local function _iE(model)
    if not model then return false end
    if tostring(model:GetAttribute("Dead")) == "true" then return false end
    local h = model:GetAttribute("Health")
    if h and h <= 0 then return false end
    local ow = _P:FindFirstChild(model.Name)
    if not ow then return false end
    if _CF.TC then
        local myT = _LP:GetAttribute("Team")
        if myT and ow:GetAttribute("Team") == myT then return false end
    end
    return true
end

local function _gBB(m)
    local ok, cf, size = pcall(function()
        local c, s = m:GetBoundingBox()
        return c, s
    end)
    if ok and cf and size and size.Y > 0 then
        return cf.Position + Vector3.new(0, size.Y / 2, 0),
               cf.Position - Vector3.new(0, size.Y / 2, 0)
    end
    local hrp = m:FindFirstChild("HumanoidRootPart")
    if hrp then
        return hrp.Position + Vector3.new(0, 3, 0),
               hrp.Position - Vector3.new(0, 3, 0)
    end
    return nil, nil
end

-- ============ 子追 ============
local _SO = nil
local _SH = false
local _SE = nil
local _ct = nil
local _lt = 0

local function _fT()
    local now = os.clock()
    if now - _lt < 0.05 and _ct and _ct.Parent then return _ct end

    local folder = _W:FindFirstChild("Characters")
    if not folder then return nil end

    local origin = _C.CFrame.Position
    local center = _C.ViewportSize / 2
    local best, bestScore

    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m.Name ~= _LP.Name and _iE(m) then
            local p = m:FindFirstChild(_CF.AP) or m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
            if p then
                local wd = (p.Position - origin).Magnitude
                if wd <= _CF.MD then
                    local sp, on = _C:WorldToViewportPoint(p.Position)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd <= _CF.SF then
                            local score = sd + wd * 0.02
                            if not bestScore or score < bestScore then
                                best, bestScore = p, score
                            end
                        end
                    end
                end
            end
        end
    end

    _ct = best
    _lt = now
    return best
end

local function _rw(payload)
    if type(payload) ~= "table" or type(payload.Bullets) ~= "table" then return end
    local tp = _fT()
    if not tp then return end
    for _, b in ipairs(payload.Bullets) do
        if type(b) == "table" and typeof(b.Origin) == "Vector3" then
            local off = tp.Position - b.Origin
            local d = off.Magnitude
            if d > 0.1 then
                b.Direction = off / d
            end
        end
    end
end

local function _try()
    if _SH then return true end
    if not _SP then _SE = "找不到武器事件" return false end
    if type(hookfunction) ~= "function" then _SE = "不支持 hook" return false end
    local ok, result = pcall(hookfunction, _SP.Send, function(payload, ...)
        if _CF.S then pcall(_rw, payload) end
        if type(_SO) == "function" then
            return _SO(payload, ...)
        end
    end)
    if ok and type(result) == "function" then
        _SO = result
        _SH = true
        return true
    else
        _SE = tostring(result)
        return false
    end
end

