        if f.Name ~= _K19 then table.insert(r, f.Name) end
    end
    table.sort(r)
    return r
end

function _SK:ApplySkin(vm, folder, skin, wear)
    if not vm then return false end
    wear = wear or _K17
    local wm = vm:FindFirstChild(_K15)
    if not wm then return false end
    local sf = _R:FindFirstChild(_K1)
    sf = sf and sf:FindFirstChild(_K2)
    if not sf then return false end
    local p = sf:FindFirstChild(folder)
    if not p then return false end
    p = p:FindFirstChild(skin)
    if not p then return false end
    p = p:FindFirstChild(_K16)
    if not p then return false end
    local wf = p:FindFirstChild(wear)
    if not wf then
        local k = p:GetChildren()
        if #k > 0 then wf = k[1] end
    end
    if not wf then return false end
    local sas = {}
    for _, sa in ipairs(wf:GetChildren()) do
        if sa:IsA(_K23) then sas[sa.Name] = sa end
    end
    local n = 0
    for _, mp in ipairs(wm:GetDescendants()) do
        if mp:IsA("MeshPart") then
            local old = mp:FindFirstChildOfClass(_K23)
            if old then
                local s = sas[old.Name] or sas[mp.Name]
                if s then
                    local c = s:Clone()
                    old:Destroy()
                    c.Parent = mp
                    n = n + 1
                end
            end
        end
    end
    return n > 0
end

function _SK:ApplyGlove(vm, gType, skin, wear)
    if not vm then return false end
    wear = wear or _K18
    local sf = _R:FindFirstChild(_K1)
    sf = sf and sf:FindFirstChild(_K2)
    if not sf then return false end
    local p = sf:FindFirstChild(gType)
    if not p then return false end
    p = p:FindFirstChild(skin)
    if not p then return false end
    p = p:FindFirstChild(_K16)
    if not p then return false end
    local wf = p:FindFirstChild(wear)
    if not wf then
        local k = p:GetChildren()
        if #k > 0 then wf = k[1] end
    end
    if not wf then return false end
    local saMap = {}
    for _, sa in ipairs(wf:GetChildren()) do
        if sa:IsA(_K23) then saMap[sa.Name] = sa end
    end
    local n = 0
    for _, arm in ipairs({_K20, _K21}) do
        local a = vm:FindFirstChild(arm)
        if a then
            local gl = a:FindFirstChild(_K22)
            if gl and gl:IsA("MeshPart") then
                local old = gl:FindFirstChildOfClass(_K23)
                local s = saMap[arm]
                if old and s then
                    local c = s:Clone()
                    old:Destroy()
                    c.Parent = gl
                    n = n + 1
                end
            end
        end
    end
    if n > 0 then self.Glove = {type = gType, skin = skin, wear = wear} end
    return n > 0
end

