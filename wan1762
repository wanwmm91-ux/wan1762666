                                        label.Font = Enum.Font.GothamBold
                                        label.TextStrokeTransparency = 0
                                        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                        label.TextXAlignment = Enum.TextXAlignment.Center
                                        label.ZIndex = 46
                                        label.Parent = _EC2
                                        _EB[m] = { box = box, stroke = stroke, label = label }
                                    end
                                    local b = _EB[m]
                                    local owner = _P:FindFirstChild(m.Name)
                                    local isAlly = false
                                    if _CF.EC and myTeam and owner then
                                        if owner:GetAttribute("Team") == myTeam then
                                            isAlly = true
                                        end
                                    end
                                    local color = isAlly and Color3.fromRGB(60, 255, 100) or Color3.fromRGB(255, 60, 60)
                                    local w = h * 0.55
                                    local cx = (topSp.X + botSp.X) / 2
                                    local leftX = cx - w / 2
                                    b.box.Visible = true
                                    b.box.Position = UDim2.new(0, leftX, 0, topSp.Y)
                                    b.box.Size = UDim2.new(0, w, 0, h)
                                    b.stroke.Color = color
                                    b.label.Visible = true
                                    b.label.Position = UDim2.new(0, cx - 100, 0, botSp.Y + 2)
                                    if _CF.ED then
                                        local d = (topPos - myPos).Magnitude
                                        b.label.Text = string.format("%s [%dm]", m.Name:sub(1, 15), math.floor(d))
                                    else
                                        b.label.Text = m.Name:sub(1, 15)
                                    end
                                    b.label.TextColor3 = color
                                else
                                    if _EB[m] then
                                        _EB[m].box.Visible = false
                                        _EB[m].label.Visible = false
                                    end
                                end
                            else
                                if _EB[m] then
                                    _EB[m].box.Visible = false
                                    _EB[m].label.Visible = false
                                end
                            end
                        end
                    end
                end

